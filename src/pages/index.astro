---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeGraph from '../components/KnowledgeGraph';
import { featuredWorks } from '../data/site';
---
<BaseLayout title="Utakata | Ideas" description="アイデアは、日常に転がっている。日常の疑問から生まれる技術と制作物。">
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-16 sm:pt-24">
    <p class="mb-6 text-sm uppercase tracking-[0.32em] text-indigo-300">Ideas are everywhere.</p>
    <h1 class="max-w-4xl text-5xl font-bold leading-tight tracking-tight sm:text-7xl">アイデアは、<br /><span class="text-indigo-300">日常に転がっている。</span></h1>
    <p class="mt-8 max-w-2xl text-lg leading-9 text-slate-300">暮らしの中の小さな不便や疑問から、技術で何ができるかを考える。作って、試して、また考える。</p>
  </section>
  <section aria-labelledby="graph-heading" class="mx-auto max-w-6xl px-5 pb-24">
    <h2 id="graph-heading" class="mb-6 text-2xl font-semibold">Explore connections</h2>
    <KnowledgeGraph client:load />
  </section>
  <section class="mx-auto max-w-6xl px-5 pb-24">
    <p class="mb-4 text-xs uppercase tracking-widest text-indigo-300">Philosophy</p>
    <h2 class="mb-6 text-3xl font-semibold">困ったことから、考えてみる。</h2>
    <p class="max-w-3xl text-lg leading-9 text-slate-300">「こんなものがあったらいいのに」。そんな思いつきは、どこか特別な場所ではなく、毎日の生活の中にある。解決できるかわからなくても、まず試してみることを大切にしています。</p>
  </section>
  <section class="mx-auto max-w-6xl px-5 pb-24" aria-labelledby="works-heading">
    <div class="mb-6 flex items-baseline justify-between gap-4"><h2 id="works-heading" class="text-3xl font-semibold">Works</h2><a href="/works" class="text-indigo-300 underline underline-offset-4">一覧を見る →</a></div>
    {featuredWorks.length ? <div class="grid gap-4 sm:grid-cols-3">{featuredWorks.map((work) => <article class="rounded-2xl border border-slate-700 p-6"><h3 class="text-xl font-semibold">{work.title}</h3><p class="mt-3 text-slate-300">{work.summary}</p>{work.href && <a href={work.href} class="mt-4 inline-block text-indigo-300 underline">詳細</a>}</article>)}</div> : <p class="rounded-2xl border border-dashed border-slate-700 p-8 text-slate-400">紹介する作品を選定中です。</p>}
  </section>
  <section id="about" class="mx-auto max-w-6xl px-5 pb-24">
    <p class="mb-4 text-xs uppercase tracking-widest text-indigo-300">About</p>
    <h2 class="mb-5 text-3xl font-semibold">つくる人について</h2>
    <p class="max-w-2xl leading-9 text-slate-300">フロントエンドエンジニア。React / Next.jsを中心に、必要に応じてRustやGoなども使いながら、日常の疑問を形にしています。</p>
    <a class="mt-5 inline-block text-indigo-300 underline underline-offset-4" href="https://github.com/UtakataKyosui" rel="me noopener noreferrer">GitHub →</a>
  </section>
</BaseLayout>
